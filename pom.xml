	<build>
		<plugins>
			<plugin>
				<!--<configuration>
					<excludeDockerCompose>false</excludeDockerCompose>
				</configuration> -->
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
